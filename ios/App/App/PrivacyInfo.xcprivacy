<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        LoveLog Privacy Manifest (Apple 2024+ zorunlu, App Store reddi nedeni #1).
        Bu dosya Xcode'da File → Add Files to "App" ile projeye eklenmelidir;
        otomatik kopyalanmaz. Bundle Resources içinde olmalı.
    -->

    <!-- Reklam takibi yapmıyoruz -->
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!-- Toplanan veri tipleri -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeDeviceID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
    </array>

    <!--
        Erişilen "Required Reason" API'ler. Apple bunlara documented gerekçe ister.
        UserDefaults: localStorage altında WKWebView UserDefaults kullanır → CA92.1
        FileTimestamp: yok
        SystemBootTime: yok
        DiskSpace: yok
    -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <!-- CA92.1: app'in kendi kullanım verisini saklamak -->
                <string>CA92.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
